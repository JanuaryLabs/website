{
  "$schema": "https://turbo.build/schema.json",
  "dangerouslyDisablePackageManagerCheck": true,
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_STATIC_EXPORT",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_VERCEL_URL",
        "NEXT_PUBLIC_DIST_URL",
        "NEXT_PUBLIC_DOCS_URL",
        "NEXT_PUBLIC_BASE_PATH",
        "NEXT_PUBLIC_DATA_URL"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_STATIC_EXPORT",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_VERCEL_URL",
        "NEXT_PUBLIC_DIST_URL",
        "NEXT_PUBLIC_DOCS_URL",
        "NEXT_PUBLIC_BASE_PATH",
        "NEXT_PUBLIC_DATA_URL"
      ]
    },
    "lint:js": {
      "inputs": [
        "**/*.{js,mjs,ts,tsx}",
        "{next-data,scripts}/**/*.json",
        "{.storybook,public}/**/*.json",
        "*.json",
        "!{node_modules,.next,.turbo,.swc,build,coverage,storybook-static}/**"
      ],
      "outputs": [".eslintjscache"]
    },
    "lint:md": {
      "inputs": [
        "**/*.{md,mdx}",
        "eslint.config.mjs",
        ".remarkrc.json",
        "!{node_modules,.next,.turbo,.swc,build,coverage,storybook-static}/**"
      ],
      "outputs": [".eslintmdcache"]
    },
    "lint:css": {
      "inputs": [
        "**/*.css",
        ".stylelintrc.mjs",
        ".stylelintignore",
        "!{node_modules,.next,.turbo,.swc,build,coverage,storybook-static}/**"
      ],
      "outputs": [".stylelintcache"]
    },
    "lint:fix": {
      "cache": false
    },
    "prettier": {
      "outputs": [".prettiercache"]
    },
    "prettier:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
