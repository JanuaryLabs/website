{
  "type": "module",
  "private": true,
  "name": "@nodejs/website",
  "description": "Nodejs.org Website",
  "homepage": "https://nodejs.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/januarylabs/nodejs.org.git"
  },
  "author": {
    "name": "Node.js Website Working Group"
  },
  "license": "MIT",
  "scripts": {
    "scripts:release-post": "cross-env NODE_NO_WARNINGS=1 node scripts/release-post/index.mjs",
    "dev": "cross-env NODE_NO_WARNINGS=1 next dev",
    "build": "cross-env NEXT_PUBLIC_STATIC_EXPORT=true NODE_NO_WARNINGS=1 next build",
    "start": "cross-env NODE_NO_WARNINGS=1 next start",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache --cache-strategy=content --cache-location=.eslintjscache",
    "lint:md": "eslint \"**/*.md?(x)\" --cache --cache-strategy=content --cache-location=.eslintmdcache",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache --cache-strategy=content --cache-location=.stylelintcache",
    "lint": "turbo run lint:md lint:js lint:css",
    "lint:fix": "turbo run lint:md lint:js lint:css --no-cache -- --fix",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix",
    "prepare": "git config core.hooksPath .husky || exit 0"
  },
  "dependencies": {
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@heroicons/react": "~2.2.0",
    "@mdx-js/mdx": "^3.1.1",
    "@nodevu/core": "~1.1.0",
    "@octokit/core": "^7.0.8",
    "@orama/highlight": "^0.1.9",
    "@radix-ui/react-accessible-icon": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@vcarl/remark-headings": "~0.1.0",
    "@vercel/analytics": "~2.0.1",
    "@vercel/speed-insights": "~2.1.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "~2.5.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "feed": "~6.0.0",
    "github-slugger": "~2.0.0",
    "glob": "~14.0.4",
    "gray-matter": "~4.0.3",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "~16.4.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "~0.4.6",
    "postcss": "~8.5.32",
    "postcss-calc": "~11.2.3",
    "postcss-mixins": "~12.1.2",
    "postcss-simple-vars": "~7.0.1",
    "posthog-js": "^1.447.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "rehype-autolink-headings": "~7.1.0",
    "rehype-expressive-code": "^0.44.3",
    "rehype-mermaid": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "~6.0.0",
    "remark-gfm": "~4.0.1",
    "remark-reading-time": "~2.1.0",
    "semver": "~7.8.6",
    "shiki": "~4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "unist-util-visit": "~5.2.0",
    "use-debounce": "^10.1.1",
    "vfile": "~6.0.3",
    "vfile-matter": "~5.0.1"
  },
  "overrides": {
    "dependencies": {
      "picocolors": "1.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@storybook/addon-themes": "~10.6.6",
    "@storybook/nextjs": "~10.6.6",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "~7.8.0",
    "@typescript-eslint/parser": "8.72.1",
    "@zukhruf/git-hooks": "0.8.10",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-mdx": "3.9.3",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-storybook": "10.6.6",
    "globals": "17.14.0",
    "handlebars": "4.7.10",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "raw-loader": "^4.0.2",
    "remark-frontmatter": "5.0.0",
    "remark-preset-lint-node": "5.2.0",
    "storybook": "~10.6.6",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "turbo": "2.11.10",
    "user-agent-data-types": "0.4.3"
  },
  "allowScripts": {
    "sharp": true,
    "esbuild": true,
    "core-js": false,
    "core-js-pure": false,
    "@vercel/speed-insights": false,
    "@parcel/watcher": false
  }
}
